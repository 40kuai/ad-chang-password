# LDAP 域控服务器配置
# 域控主机地址（FQDN 或 IP），注意与 AD 域名的区别
LDAP_HOST=192.168.1.10
# LDAPS 端口，通常 636
LDAP_PORT=636
# 是否启用 LDAPS（TLS），保持 true
LDAP_USE_SSL=true
# AD 域根（如 corp.local），用户将以 username@<LDAP_DOMAIN> 绑定
LDAP_DOMAIN=corp.local

# 审计日志文件路径
LOG_FILE=logs/audit.log

# Mock 模式：本地无真实域控演示时置为 true（旧密码须为 OldPass@123，不连接域控）
MOCK_LDAP=false
